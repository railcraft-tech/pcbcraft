(kicad_pcb
  (setup (pad_to_mask_clearance 0.05))
  (layers (0 "F.Cu" signal) (2 "B.Cu" signal) (25 "Edge.Cuts" user))
  (net 1 "GND")
  (footprint "Pkg:U" (layer "F.Cu") (at 10 10 90)
    (property "Reference" "U1" (at 0 0 90) (layer "F.SilkS"))
    (fp_rect (start -2 -1) (end 2 1) (stroke (width 0.05)) (layer "F.CrtYd"))
    (fp_arc (start 1 0) (mid 0 1) (end -1 0) (stroke (width 0.1)) (layer "F.SilkS"))
    (pad "1" smd roundrect (at 0 0 90) (size 2 0.5) (layers "F.Cu") (roundrect_rratio 0.25) (net "GND"))
    (pad "2" thru_hole oval (at 1 1) (size 1.6 1) (drill oval 1 0.6) (layers "*.Cu") (net "GND"))
    (pad "3" np_thru_hole circle (at -1 1) (size 1 1) (drill 1) (layers "*.Cu")))
  (segment (start 0 0) (end 10 0) (width 0.25) (layer "F.Cu") (net "GND"))
  (arc (start 5 0) (mid 0 5) (end -5 0) (width 0.2) (layer "F.Cu") (net "GND"))
  (via (at 5 5) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1))
  (zone (net "GND") (layer "F.Cu")
    (polygon (pts (xy 0 0) (xy 1 0) (xy 1 1) (xy 0 1)))
    (filled_polygon (layer "F.Cu") (pts (xy 0 0) (xy 4 0) (xy 4 2) (xy 0 2))))
  (gr_rect (start 0 0) (end 50 50) (stroke (width 0.05)) (layer "Edge.Cuts"))
  (gr_rect (start 40 40) (end 45 45) (stroke (width 0.05)) (layer "Edge.Cuts")))
